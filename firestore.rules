rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: usuario autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: es miembro de la familia indicada
    function isMember(familyId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    // Helper: el usuario actual es un admin con rol owner/admin
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    // Perfiles de usuario (datos de acceso/familia)
    // Solo se puede leer el propio perfil o el de un miembro de SU misma familia
    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId ==
            get(/databases/$(database)/documents/users/$(userId)).data.familyId &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId != null));
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Los administradores de la misma familia pueden actualizar roles
      allow update: if isSignedIn() &&
        (request.auth.uid == userId ||
          (isAdmin() &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == resource.data.familyId));

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Familias
    match /families/{familyId} {
      // Permitir 'get' a cualquier usuario para poder validar el código al unirse. 
      // 'list' queda restringido a miembros.
      allow get: if isSignedIn();
      allow list: if isMember(familyId);
      allow create: if isSignedIn();
      // Solo el dueño puede modificar o eliminar la familia; un miembro (o un
      // usuario que se une con el código = familyId) solo puede cambiar memberIds
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.auth.uid in request.resource.data.memberIds);

      // Perfiles de los miembros (bloque familiar): solo miembros de esta familia.
      // Un usuario puede crear/editar su propio perfil en la familia indicada en
      // su documento de usuario (flujo de "unirse por código").
      match /members/{memberId} {
        allow read: if isMember(familyId);
        allow create: if isSignedIn() && memberId == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
        allow update: if isMember(familyId) ||
          (isSignedIn() && memberId == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId);
        allow delete: if isMember(familyId) && isAdmin();
      }

      // Tareas de la familia: solo miembros
      match /tasks/{taskId} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId);
      }

      // Eventos de la familia: solo miembros
      match /events/{eventId} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId);
      }

      // Mensajes de chat familiar: solo miembros
      match /messages/{messageId} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId);
      }

      // Reportes de contenido (UGC): cualquier miembro puede reportar,
      // solo los administradores pueden leerlos.
      match /reports/{reportId} {
        allow create: if isMember(familyId);
        allow read: if isMember(familyId) && isAdmin();
      }
    }
  }
}
